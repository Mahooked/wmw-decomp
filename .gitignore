# Ghidra analysis logs are large, machine-specific, and regenerable.
out/ghidra/
*.log

# Python bytecode
__pycache__/
*.py[cod]

# Editor / OS noise
.vscode/
.idea/
Thumbs.db
.DS_Store

# The original APK and extracted assets are not redistributed here.
# See README.md -> "What is not in this repository".
*.apk

# Scratch output from validation runs.
out/smoke_src/
out/valid/

# Compiled Ghidra scripts (rebuilt from tools/ghidra on demand).
out/build/

# Raw pre-filter field-access dump (~8 MB, 39,348 rows). Regenerate with
# tools/ghidra/FieldScan.java; only the filtered out/types/fields.tsv is tracked.
out/types/_fieldraw.tsv

